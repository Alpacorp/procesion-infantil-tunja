---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import type { ImageMetadata } from "astro";
import styles from "./galeria.module.css";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/img/gallery/g*.{png,jpg,jpeg}",
  { eager: true }
);
const images = Object.keys(modules)
  .sort()
  .map((k) => ({
    src: modules[k].default,
    alt: "Fotografía histórica de la Procesión Infantil de Tunja",
  }));
---

<Layout
  title="Recorrido Visual Histórico"
  description="Galería fotográfica de la Procesión Infantil de Tunja a lo largo de su historia."
>
  <PageHeader
    eyebrow="Galería"
    title="Recorrido Visual Histórico"
    subtitle="Seis décadas de fe, tradición y comunidad en imágenes"
  />

  <section class:list={[styles.gallery, "container"]}>
    <GalleryGrid images={images} />
  </section>
</Layout>
