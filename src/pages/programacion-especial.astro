---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import type { ImageMetadata } from "astro";
import styles from "./programacion-especial.module.css";

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/img/gallery/p*.{png,jpg,jpeg}",
  { eager: true }
);
const images = Object.keys(modules)
  .sort()
  .map((k) => ({
    src: modules[k].default,
    alt: "Programación especial de la Procesión Infantil de Tunja",
  }));

const hitos = [
  "Bodas de Plata — 25 años",
  "Bodas de Oro — 50 años",
  "55º aniversario de la Procesión Infantil",
  "Exposición de los pasos de la procesión",
  "Procesión juvenil del Miércoles Santo",
  "Vía Lucis",
  "800 años de la Comunidad Clarisa",
  "Adoración al Santo Sepulcro en Santa Clara",
];
---

<Layout
  title="Programación Especial"
  description="Aniversarios, exposiciones y celebraciones especiales de la Procesión Infantil de Tunja: Bodas de Plata, Bodas de Oro y más."
>
  <PageHeader
    eyebrow="Galería"
    title="Programación Especial"
    subtitle="Aniversarios, exposiciones y celebraciones memorables"
  />

  <section class:list={[styles.intro, "container-narrow"]}>
    <ul class={styles.milestoneChips}>
      {hitos.map((h) => <li>{h}</li>)}
    </ul>
  </section>

  <section class:list={[styles.gallery, "container"]}>
    <GalleryGrid images={images} />
  </section>
</Layout>
